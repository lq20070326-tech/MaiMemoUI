<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <!-- 学习计划 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="学习计划"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_daily"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_review_limit"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_word_limit"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_order"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_study_mode"
                    layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- 记忆与复习 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="记忆与复习"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_memory_mode"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_review_mode"
                    layout="@layout/view_setting_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_auto_speak"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_accent"
                    layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- 提醒 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="学习提醒"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_remind_switch"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_remind_time"
                    layout="@layout/view_setting_row" />
            </LinearLayout>

            <!-- 学习界面 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="学习界面"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_show_example"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_show_phonetic"
                    layout="@layout/view_setting_switch_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_dark_mode"
                    layout="@layout/view_setting_switch_row" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="保存设置"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>